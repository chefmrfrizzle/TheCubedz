{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecubedz.vercel.app/schemas/capability-envelope.schema.json",
  "title": "Least-privilege capability envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_id", "task_id", "actor", "allowed_tools", "read_paths", "write_paths", "network", "quotas", "issued_at", "expires_at", "issued_by"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "capability_id": {"type": "string", "pattern": "^CAP-[0-9]{6}$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{6}$"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "role"],
      "properties": {
        "type": {"enum": ["AGENT", "VALIDATOR", "SYSTEM"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 120},
        "role": {"enum": ["ORCHESTRATOR", "SCIENCE", "BUILD", "SKEPTIC", "SECURITY", "REPRODUCTION", "EXPLAINER", "SEARCH_POLICY", "RELEASE", "DETERMINISTIC_VALIDATOR"]}
      }
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["READ_FILES", "WRITE_WORKSPACE", "RUN_TESTS", "RUN_VALIDATOR", "SEARCH_APPROVED_SOURCES", "CREATE_REVIEW_PACKET"]}
    },
    "read_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "write_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "destinations"],
      "properties": {
        "mode": {"enum": ["DENY", "ALLOWLIST"]},
        "destinations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri", "maxLength": 500}}
      }
    },
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_seconds", "memory_mb", "wall_seconds", "disk_mb", "output_mb", "processes"],
      "properties": {
        "cpu_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 65536},
        "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "disk_mb": {"type": "integer", "minimum": 1, "maximum": 102400},
        "output_mb": {"type": "integer", "minimum": 1, "maximum": 1024},
        "processes": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "issued_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["HUMAN", "POLICY_ENGINE"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    }
  }
}
