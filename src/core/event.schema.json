{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/event.schema.json",
  "title": "Append-only research event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "schema_version", "event_type", "occurred_at", "authority_tier", "actor", "subjects", "payload", "provenance"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVENT-[0-9]{6}$"},
    "schema_version": {"const": "1.0.0"},
    "event_type": {"enum": ["QUESTION_FRAMED", "CANDIDATE_REGISTERED", "VALIDATOR_REGISTERED", "RUN_COMPLETED", "CLAIM_PROPOSED", "CLAIM_STATUS_CHANGED", "REPRODUCTION_REQUESTED", "REPRODUCTION_RECORDED", "CHALLENGE_OPENED", "CORRECTION_PUBLISHED", "MODEL_EVALUATED", "MODEL_PROMOTED", "MODEL_ROLLED_BACK"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "authority_tier": {"enum": ["CANONICAL", "WORKING", "PRODUCT_ONLY"]},
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {"type": {"enum": ["HUMAN", "AGENT", "SYSTEM", "VALIDATOR"]}, "id": {"type": "string"}}
    },
    "subjects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "payload": {"type": "object"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_paths", "license"],
      "properties": {"source_paths": {"type": "array", "items": {"type": "string"}}, "license": {"type": "string"}}
    }
  }
}
