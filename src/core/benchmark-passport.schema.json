{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecubedz.vercel.app/schemas/benchmark-passport.schema.json",
  "title": "Established-geometry benchmark passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "passport_id", "passport_version", "benchmark_id", "candidate_id", "title",
    "classification", "capability_added", "scientific_review", "domain",
    "source_model", "expected_results", "preregistered_checks", "negative_cases",
    "unsupported_properties", "references", "review_history", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "passport_id": {"type": "string", "pattern": "^PASSPORT-[0-9]{6}$"},
    "passport_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "benchmark_id": {"type": "string", "pattern": "^BENCHMARK-[0-9]{6}$"},
    "candidate_id": {"type": "string", "pattern": "^CANDIDATE-[0-9]{6}$"},
    "title": {"type": "string", "minLength": 3},
    "classification": {"const": "ESTABLISHED_NON_NOVEL_GEOMETRY"},
    "capability_added": {"type": "string", "minLength": 10},
    "scientific_review": {"enum": ["REQUESTED", "APPROVED", "CHANGES_REQUIRED", "REJECTED"]},
    "domain": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinates", "coordinate_ranges", "excluded_boundaries"],
      "properties": {
        "coordinates": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "coordinate_ranges": {"type": "string", "minLength": 1},
        "excluded_boundaries": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_model": {
      "type": "object", "additionalProperties": false,
      "required": ["cosmological_constant", "stress_energy", "interpretation"],
      "properties": {
        "cosmological_constant": {"type": "number"},
        "stress_energy": {"type": "string"},
        "interpretation": {"type": "string"}
      }
    },
    "expected_results": {
      "type": "object", "additionalProperties": false,
      "required": [
        "from_coordinates", "to_coordinates", "reference_metric", "jacobian",
        "submitted_metric", "submitted_determinant", "submitted_inverse", "metric_signature",
        "coordinate_relation", "connection", "curvature", "stress_energy", "tolerance"
      ],
      "properties": {
        "from_coordinates": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "to_coordinates": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "reference_metric": {"$ref": "#/$defs/matrix"},
        "jacobian": {"$ref": "#/$defs/matrix"},
        "submitted_metric": {"$ref": "#/$defs/matrix"},
        "submitted_determinant": {"type": "number"},
        "submitted_inverse": {"$ref": "#/$defs/exactMatrix"},
        "metric_signature": {"const": "-+++"},
        "coordinate_relation": {"const": "g_submitted = J^T g_reference J"},
        "connection": {"const": "all zero"},
        "curvature": {"const": "all zero"},
        "stress_energy": {"const": "all zero"},
        "tolerance": {"const": "exact rational equality"}
      }
    },
    "preregistered_checks": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "negative_cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["case", "expected_failure"],
        "properties": {"case": {"type": "string"}, "expected_failure": {"type": "string"}}
      }
    },
    "unsupported_properties": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "references": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "url", "purpose"],
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "purpose": {"type": "string"}
        }
      }
    },
    "review_history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["review_id", "outcome", "reviewed_at", "reviewer", "summary", "required_corrections", "response_status"],
        "properties": {
          "review_id": {"type": "string", "pattern": "^REVIEW-[0-9]{6}$"},
          "outcome": {"enum": ["APPROVED", "CHANGES_REQUIRED", "REJECTED"]},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "reviewer": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "required_corrections": {"type": "array", "items": {"type": "string"}},
          "response_status": {"enum": ["OPEN", "ADDRESSED_AWAITING_REREVIEW", "CLOSED"]}
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["implementation_authorized_by", "implemented_by", "created_at", "updated_at", "license", "human_scientific_review_required"],
      "properties": {
        "implementation_authorized_by": {"type": "string"},
        "implemented_by": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "license": {"type": "string"},
        "human_scientific_review_required": {"const": true}
      }
    }
  },
  "$defs": {
    "matrix": {
      "type": "array", "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}
    },
    "exactMatrix": {
      "type": "array", "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": ["number", "string"]}}
    }
  }
}
