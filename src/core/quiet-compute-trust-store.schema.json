{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecubedz.vercel.app/schemas/quiet-compute-trust-store.schema.json",
  "title": "Quiet Compute job-signing trust store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key_base64", "status", "not_before", "not_after"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^QC-KEY-[A-Za-z0-9_-]{3,80}$"},
          "algorithm": {"const": "Ed25519"},
          "public_key_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
          "status": {"enum": ["ACTIVE", "REVOKED"]},
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
