{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecubedz.vercel.app/schemas/agent-run.schema.json",
  "title": "Agent or validator run record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "capability_id", "actor", "status", "prompt", "model", "source_commit", "input_hashes", "output_hashes", "started_at", "finished_at", "canonical_write_performed"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^RUN-[0-9]{6}$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{6}$"},
    "capability_id": {"type": "string", "pattern": "^CAP-[0-9]{6}$"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "role"],
      "properties": {
        "type": {"enum": ["AGENT", "VALIDATOR", "SYSTEM"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 120},
        "role": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "status": {"enum": ["RUNNING", "FAILED", "REVIEW_REQUIRED", "CHANGES_REQUESTED", "REJECTED", "AWAITING_REPRODUCTION"]},
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 80},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id", "version"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 80},
        "id": {"type": "string", "minLength": 1, "maxLength": 160},
        "version": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "source_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|UNAVAILABLE)$"},
    "input_hashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "output_hashes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "canonical_write_performed": {"const": false}
  }
}
