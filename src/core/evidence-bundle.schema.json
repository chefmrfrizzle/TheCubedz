{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecubedz.vercel.app/schemas/evidence-bundle.schema.json",
  "title": "Content-addressed evidence bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "task_id", "run_ids", "source_commit", "environment", "artifacts", "gate_results", "limitations", "created_at", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_id": {"type": "string", "pattern": "^BUNDLE-[0-9]{6}$"},
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{6}$"},
    "run_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-[0-9]{6}$"}},
    "source_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|UNAVAILABLE)$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python", "node", "dependency_lock_sha256"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "node": {"type": "string", "minLength": 1},
        "dependency_lock_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 120},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "status", "evidence"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "UNRESOLVED", "NOT_REQUIRED"]},
          "evidence": {"type": "array", "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
