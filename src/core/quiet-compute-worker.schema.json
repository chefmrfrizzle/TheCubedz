{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thecubedz.vercel.app/schemas/quiet-compute-worker.schema.json",
  "title": "Quiet Compute worker capability profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_id", "operator_id", "independence_group", "status", "os_family", "hardware_family", "sensor_stack", "operations", "trusted_key_ids", "approved_runtime_digests", "result_public_key_base64", "capacity", "sandbox_attestation"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "worker_id": {"type": "string", "pattern": "^QC-WORKER-[0-9]{6}$"},
    "operator_id": {"type": "string", "minLength": 3, "maxLength": 120},
    "independence_group": {"type": "string", "minLength": 3, "maxLength": 120},
    "status": {"enum": ["ACTIVE", "PAUSED", "QUARANTINED", "REVOKED"]},
    "os_family": {"enum": ["LINUX", "WINDOWS", "MACOS", "OTHER"]},
    "hardware_family": {"type": "string", "minLength": 2, "maxLength": 120},
    "sensor_stack": {"type": "string", "minLength": 2, "maxLength": 120},
    "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["VALIDATE_MEASUREMENT", "COMPARE_MEASUREMENTS", "REPRODUCE_FROZEN_BENCHMARK"]}},
    "trusted_key_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^QC-KEY-[A-Za-z0-9_-]{3,80}$"}},
    "approved_runtime_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "result_public_key_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"},
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_cores", "memory_mb", "disk_mb", "wall_seconds", "output_mb", "processes", "gpu_count"],
      "properties": {
        "cpu_cores": {"type": "number", "exclusiveMinimum": 0, "maximum": 256},
        "memory_mb": {"type": "integer", "minimum": 64, "maximum": 1048576},
        "disk_mb": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "wall_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "output_mb": {"type": "integer", "minimum": 1, "maximum": 1024},
        "processes": {"type": "integer", "minimum": 1, "maximum": 1024},
        "gpu_count": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "sandbox_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "rootless", "network_deny_enforced", "read_only_root_enforced", "no_new_privileges", "capabilities_dropped", "attested_at", "attestation_digest"],
      "properties": {
        "runtime": {"enum": ["ROOTLESS_DOCKER", "ROOTLESS_PODMAN", "FIRECRACKER", "OTHER_REVIEWED"]},
        "rootless": {"const": true},
        "network_deny_enforced": {"const": true},
        "read_only_root_enforced": {"const": true},
        "no_new_privileges": {"const": true},
        "capabilities_dropped": {"const": true},
        "attested_at": {"type": "string", "format": "date-time"},
        "attestation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
