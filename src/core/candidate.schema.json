{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/candidate.schema.json",
  "title": "Spacetime Research Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "version",
    "title",
    "status",
    "coordinates",
    "metric",
    "parameters",
    "assumptions",
    "references",
    "provenance"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^CANDIDATE-[0-9]{6}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATING",
        "MATHEMATICALLY_VALID",
        "MATHEMATICALLY_INVALID",
        "PHYSICALLY_PROBLEMATIC",
        "UNRESOLVED",
        "REPRODUCTION_PENDING",
        "REPRODUCED",
        "FALSIFIED",
        "EXPERT_REVIEW",
        "ARCHIVED"
      ]
    },
    "coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "metric": {
      "type": "object",
      "required": ["representation", "components"],
      "properties": {
        "representation": {"type": "string"},
        "components": {"type": "array"},
        "signature": {"type": "string"}
      },
      "additionalProperties": true
    },
    "parameters": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "object"}},
    "provenance": {
      "type": "object",
      "required": ["created_by", "created_at"],
      "properties": {
        "created_by": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"},
        "source_commit": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
